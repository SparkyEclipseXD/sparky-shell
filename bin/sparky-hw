#!/usr/bin/env python3
import json
import subprocess
import sys

KWIN = ["qdbus6", "org.kde.KWin"]
DEV = "/org/kde/KWin/InputDevice"
IFACE = "org.kde.KWin.InputDevice"

def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

def displays():
    d = json.loads(run("kscreen-doctor", "-j").stdout or "{}")
    out = []
    for o in d.get("outputs", []):
        if not o.get("enabled"):
            continue
        cur = o.get("currentModeId")
        modes, seen = [], set()
        for m in o.get("modes", []):
            w, h, hz = m["size"]["width"], m["size"]["height"], m["refreshRate"]
            key = (w, h, round(hz))
            if key in seen and m["id"] != cur:
                continue
            seen.add(key)
            modes.append({"id": m["id"], "width": w, "height": h, "hz": round(hz, 2), "current": m["id"] == cur})
        modes.sort(key=lambda m: (-m["width"] * m["height"], -m["hz"]))
        current = next((m for m in modes if m["current"]), None)
        out.append({"name": o["name"], "id": o["id"], "model": o.get("model") or o["name"],
                    "scale": o.get("scale", 1), "current": current, "modes": modes})
    return out

def set_mode(output, mode_id):
    r = run("kscreen-doctor", f"output.{output}.mode.{mode_id}")
    if r.returncode != 0:
        sys.exit(r.stderr.strip() or "kscreen-doctor failed")

def prop(dev, key):
    r = run(*KWIN, f"{DEV}/{dev}", "org.freedesktop.DBus.Properties.Get", IFACE, key)
    v = r.stdout.strip()
    if v in ("true", "false"):
        return v == "true"
    try:
        return float(v) if "." in v else int(v)
    except ValueError:
        return v

def bluetooth_keyboards():
    names = set()
    for line in run("bluetoothctl", "devices", "Paired").stdout.splitlines():
        parts = line.split(" ", 2)
        if len(parts) < 2:
            continue
        info = run("bluetoothctl", "info", parts[1]).stdout
        alias = next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.strip().startswith("Alias:")), "")
        if "Icon: input-keyboard" in info and alias:
            names.add(alias)
    return names

def mice():
    names = run(*KWIN, DEV, "org.kde.KWin.InputDeviceManager.devicesSysNames").stdout.split()
    keyboards = bluetooth_keyboards()
    out = []
    for dev in names:
        if not prop(dev, "pointer") or prop(dev, "touchpad"):
            continue
        name = prop(dev, "name")
        if "virtual" in str(name).lower() or "ydotool" in str(name).lower() or name in keyboards:
            continue
        out.append({
            "sys": dev, "name": name, "vendor": prop(dev, "vendor"), "product": prop(dev, "product"),
            "pointerAcceleration": prop(dev, "pointerAcceleration"),
            "flat": prop(dev, "pointerAccelerationProfileFlat"),
            "naturalScroll": prop(dev, "naturalScroll"),
            "leftHanded": prop(dev, "leftHanded"),
            "middleEmulation": prop(dev, "middleEmulation"),
            "scrollFactor": prop(dev, "scrollFactor"),
        })
    return out

MOUSE_KEYS = {
    "pointerAcceleration": ("pointerAcceleration", "double", "PointerAcceleration"),
    "naturalScroll": ("naturalScroll", "bool", "NaturalScroll"),
    "leftHanded": ("leftHanded", "bool", "LeftHanded"),
    "middleEmulation": ("middleEmulation", "bool", "MiddleButtonEmulation"),
    "scrollFactor": ("scrollFactor", "double", "ScrollFactor"),
}

def set_dbus(dev, prop_name, typ, value):
    import dbus
    obj = dbus.SessionBus().get_object("org.kde.KWin", f"{DEV}/{dev}")
    v = dbus.Boolean(str(value).lower() == "true") if typ == "bool" else dbus.Double(float(value))
    dbus.Interface(obj, "org.freedesktop.DBus.Properties").Set(IFACE, prop_name, v)

def save(dev, key, value):
    group = ["Libinput", str(prop(dev, "vendor")), str(prop(dev, "product")), str(prop(dev, "name"))]
    args = ["kwriteconfig6", "--file", "kcminputrc"]
    for g in group:
        args += ["--group", g]
    run(*args, "--key", key, str(value))

def set_mouse(dev, key, value):
    if key == "flat":
        flat = value == "true"
        set_dbus(dev, "pointerAccelerationProfileFlat", "bool", "true" if flat else "false")
        set_dbus(dev, "pointerAccelerationProfileAdaptive", "bool", "false" if flat else "true")
        save(dev, "PointerAccelerationProfile", 1 if flat else 2)
        return
    prop_name, typ, conf = MOUSE_KEYS[key]
    if typ == "double":
        value = f"{float(value):.3f}"
    set_dbus(dev, prop_name, typ, value)
    save(dev, conf, value)

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "displays":
        print(json.dumps(displays()))
    elif cmd == "set-mode":
        set_mode(sys.argv[2], sys.argv[3])
    elif cmd == "mice":
        print(json.dumps(mice()))
    elif cmd == "set-mouse":
        set_mouse(sys.argv[2], sys.argv[3], sys.argv[4])
    else:
        sys.exit(__doc__)
