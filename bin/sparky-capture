#!/usr/bin/env python3
import os
import shutil
import sys
import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()
loop = GLib.MainLoop()
result = {}

def on_response(code, results):
    if code == 0:
        result["uri"] = str(results["uri"])
    loop.quit()

portal = bus.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
shot = dbus.Interface(portal, "org.freedesktop.portal.Screenshot")
sender = bus.get_unique_name()[1:].replace(".", "_")
token = f"sparky_capture_{os.getpid()}"
handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
bus.add_signal_receiver(on_response, "Response", "org.freedesktop.portal.Request", path=handle)
shot.Screenshot("", {"interactive": False, "handle_token": token})
GLib.timeout_add_seconds(20, loop.quit)
loop.run()
if "uri" not in result:
    sys.exit(1)
path = result["uri"].removeprefix("file://")
if len(sys.argv) > 1:
    os.makedirs(os.path.dirname(sys.argv[1]), exist_ok=True)
    shutil.move(path, sys.argv[1])
    path = sys.argv[1]
print(path)
