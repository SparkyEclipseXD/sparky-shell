#!/usr/bin/env python3
import json
import os
import platform
import shutil
import sys
import time

CACHE = os.path.expanduser("~/.cache/sparky/weather.json")
WALLPAPERS = os.path.expanduser("~/.config/sparky/wallpapers.json")

def refresh():
    import urllib.request
    with urllib.request.urlopen("https://wttr.in/?format=j1", timeout=10) as r:
        d = json.load(r)
    c, day = d["current_condition"][0], d["weather"][0]
    imperial = os.environ.get("LC_MEASUREMENT", os.environ.get("LANG", "")).startswith("en_US")
    u = "F" if imperial else "C"
    out = {"temp": c["temp_" + u], "feels": c["FeelsLike" + u], "high": day["maxtemp" + u],
           "low": day["mintemp" + u], "desc": c["weatherDesc"][0]["value"].strip(),
           "code": int(c["weatherCode"]), "time": time.time()}
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(out, f)
    os.replace(tmp, CACHE)

def cpu_times():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    return v[3] + v[4], sum(v)

def mem():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            info[k] = int(v.split()[0])
    return 1 - info.get("MemAvailable", 0) / info.get("MemTotal", 1)

def temp():
    base = "/sys/class/hwmon"
    for h in sorted(os.listdir(base)):
        try:
            with open(f"{base}/{h}/name") as f:
                if f.read().strip() in ("k10temp", "coretemp", "zenpower"):
                    with open(f"{base}/{h}/temp1_input") as t:
                        return round(int(t.read()) / 1000)
        except OSError:
            pass
    return None

def info():
    try:
        with open("/etc/os-release") as f:
            osr = dict(l.rstrip().split("=", 1) for l in f if "=" in l)
        os_name = osr.get("NAME", "Linux").strip('"')
    except OSError:
        os_name = "Linux"
    try:
        with open("/sys/devices/virtual/dmi/id/board_name") as f:
            host = f.read().strip()
    except OSError:
        host = platform.node()
    with open("/proc/uptime") as f:
        mins = int(float(f.read().split()[0]) // 60)
    h, m = divmod(mins, 60)
    uptime = f"{m} min{'s' * (m != 1)}" if h == 0 else f"{h} hour{'s' * (h != 1)}, {m} min{'s' * (m != 1)}"

    a = cpu_times()
    time.sleep(0.4)
    b = cpu_times()
    didle, dtotal = b[0] - a[0], b[1] - a[1]
    disk = shutil.disk_usage("/")

    weather = None
    try:
        with open(CACHE) as f:
            weather = json.load(f)
        if time.time() - weather.get("time", 0) > 6 * 3600:
            weather = None
    except (OSError, ValueError):
        pass

    wallpaper = ""
    try:
        with open(WALLPAPERS) as f:
            wallpaper = json.load(f).get("current", "")
    except (OSError, ValueError):
        pass
    still = ""
    if wallpaper.lower().endswith((".mp4", ".gif")):
        cand = os.path.expanduser("~/.cache/sparky/thumbs/" + os.path.basename(wallpaper) + ".jpg")
        still = cand if os.path.exists(cand) else ""

    return {"os": os_name, "kernel": platform.release().split("-")[0], "host": host, "uptime": uptime,
            "cpu": 1 - didle / dtotal if dtotal else 0, "mem": mem(), "disk": disk.used / disk.total,
            "temp": temp(), "weather": weather, "wallpaper": wallpaper, "still": still}

if __name__ == "__main__":
    if "--refresh" in sys.argv:
        try:
            refresh()
        except Exception as e:
            print("weather refresh failed:", e, file=sys.stderr)
            sys.exit(1)
    else:
        print(json.dumps(info()))
